-- THEME (white, brown, black)
local PotatoTheme = {
    Background = Color3.fromRGB(220, 200, 180), -- light potato
    Dark = Color3.fromRGB(80, 60, 40),          -- dark brown
    Accent = Color3.fromRGB(255, 255, 255),     -- white accent
    Text = Color3.fromRGB(0, 0, 0),             -- black text
    Roundness = 12,
}

local function applyPotatoStyle(object)
    if object:IsA("Frame") or object:IsA("TextButton") or object:IsA("TextLabel") then
        object.BackgroundColor3 = PotatoTheme.Background
        object.BorderSizePixel = 0
        if object:IsA("TextLabel") or object:IsA("TextButton") then
            object.TextColor3 = PotatoTheme.Text
        end

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, PotatoTheme.Roundness)
        corner.Parent = object
    end
end

