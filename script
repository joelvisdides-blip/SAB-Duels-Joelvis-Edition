local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local UIS = game:GetService("UserInputService")
local RS = game:GetService("RunService")

-- SETTINGS
local infiniteJump = true
local antiStun = true
local lowKB = true
local kbMultiplier = 0.15
local espEnabled = true
local hitboxEnabled = true
local auraEnabled = true

local auraRange = 12
local swingCooldown = 0.35
local lastSwing = 0

local expandSize = Vector3.new(6, 6, 6)

--============================--
--         TOGGLE KEYS        --
--============================--

UIS.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.F then
        infiniteJump = not infiniteJump
        print("Infinite Jump:", infiniteJump)

    elseif input.KeyCode == Enum.KeyCode.H then
        antiStun = not antiStun
        print("Anti-Stun:", antiStun)

    elseif input.KeyCode == Enum.KeyCode.G then
        lowKB = not lowKB
        print("Low Knockback:", lowKB)

    elseif input.KeyCode == Enum.KeyCode.T then
        auraEnabled = not auraEnabled
        print("Auto-M1 Aura:", auraEnabled)

    elseif input.KeyCode == Enum.KeyCode.Y then
        hitboxEnabled = not hitboxEnabled
        print("Hitbox Expander:", hitboxEnabled)

    elseif input.KeyCode == Enum.KeyCode.U then
        espEnabled = not espEnabled
        print("ESP:", espEnabled)
    end
end)

--============================--
--       INFINITE JUMP        --
--============================--

UIS.JumpRequest:Connect(function()
    if infiniteJump then
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end
end)

--============================--
--   ANTI-STUN + LOW KB CORE  --
--============================--

RS.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")

    if hum and antiStun then
        hum.PlatformStand = false
        hum.Sit = false
    end

    if hrp then
        if antiStun and hrp.Anchored then
            hrp.Anchored = false
        end

        if lowKB and hrp.Velocity.Magnitude > 2 then
            hrp.Velocity = hrp.Velocity * kbMultiplier
        end
    end
end)

--============================--
--       AUTO-M1 AURA         --
--============================--

local function getNearestEnemy()
    local nearest, nearestDist = nil, math.huge

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = plr.Character.HumanoidRootPart
            local myChar = LocalPlayer.Character
            if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                local dist = (hrp.Position - myChar.HumanoidRootPart.Position).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                    nearest = plr
                end
            end
        end
    end

    return nearest, nearestDist
end

RS.Heartbeat:Connect(function()
    if not auraEnabled then return end

    local char = LocalPlayer.Character
    if not char then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    local enemy, dist = getNearestEnemy()
    if enemy and dist <= auraRange then
        if tick() - lastSwing >= swingCooldown then
            lastSwing = tick()
            hum:ChangeState(Enum.HumanoidStateType.Attacking)
        end
    end
end)

--============================--
--       TEAM-COLOR ESP       --
--============================--

local function getTeamColor(player)
    if player.Team then
        return player.Team.TeamColor.Color
    else
        return Color3.fromRGB(255, 0, 0)
    end
end

local function createESP(player)
    if not espEnabled then return end
    if player == LocalPlayer then return end

    local char = player.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local color = getTeamColor(player)

    -- Name ESP
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP_Name"
    billboard.Size = UDim2.new(0, 100, 0, 20)
    billboard.Adornee = hrp
    billboard.AlwaysOnTop = true

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Parent = billboard
    nameLabel.Size = UDim2.new(1, 0, 1, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.Name
    nameLabel.TextColor3 = color
    nameLabel.TextStrokeTransparency = 0.5
    nameLabel.Font = Enum.Font.SourceSansBold
    nameLabel.TextSize = 16

    billboard.Parent = hrp

    -- Box ESP
    local box = Instance.new("BoxHandleAdornment")
    box.Name = "ESP_Box"
    box.Adornee = char
    box.Size = char:GetExtentsSize()
    box.Color3 = color
    box.Transparency = 0.5
    box.AlwaysOnTop = true
    box.Parent = hrp
end

local function removeESP(player)
    local char = player.Character
    if not char then return end

    for _, obj in pairs(char:GetDescendants()) do
        if obj.Name == "ESP_Box" or obj.Name == "ESP_Name" then
            obj:Destroy()
        end
    end
end

local function updateESP()
    for _, plr in pairs(Players:GetPlayers()) do
        removeESP(plr)
        createESP(plr)
    end
end

--============================--
--      HITBOX EXPANDER       --
--============================--

local function expandHitbox(char)
    if not hitboxEnabled then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if hrp:FindFirstChild("HitboxExpand") then
        hrp.HitboxExpand:Destroy()
    end

    local hb = Instance.new("Part")
    hb.Name = "HitboxExpand"
    hb.Size = expandSize
    hb.Transparency = 1
    hb.CanCollide = false
    hb.Anchored = false
    hb.Parent = hrp

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = hrp
    weld.Part1 = hb
    weld.Parent = hb
end

local function updateHitboxes()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            expandHitbox(plr.Character)
        end
    end
end

--============================--
--         AUTO-REFRESH       --
--============================--

Players.PlayerAdded:Connect(function(plr)
    plr.CharacterAdded:Connect(function()
        task.wait(0.3)
        updateESP()
        updateHitboxes()
    end)
end)

Players.PlayerRemoving:Connect(function(plr)
    removeESP(plr)
end)

updateESP()
updateHitboxes()

game:GetService("RunService").Heartbeat:Connect(function()
    print("running")
end)
print("Joelvis script loaded!")
